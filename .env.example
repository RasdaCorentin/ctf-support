# Copier ce fichier vers .env (ignoré par git) et remplir les valeurs. Ne jamais committer .env.
DISCORD_TOKEN=
# Identifiants des salons tickets (séparés par des virgules). Un 👀 posé dans l'un d'eux ouvre un ticket.
TICKETS_CHANNEL_IDS=
# Identifiants Discord (séparés par des virgules) autorisés à ouvrir un ticket en posant 👀 sur un message du
# salon. Le propriétaire de l'application l'est toujours. Vide : le propriétaire seul.
TRIGGER_USER_IDS=
# Permissions du bot sur chaque salon tickets : Voir le salon, Envoyer des messages, Lire l'historique des messages,
# Ajouter des réactions (👀 et 🕐 sur chaque ticket).
# 1 = dry-run (rien n'est publié). Mettre 0 uniquement quand le test est validé.
SUPPORT_DRY_RUN=1
# Brouillons du rédacteur (Gemini). 0 : aucun appel réseau, comportement sans brouillon.
LLM_ENABLED=0
# Clé du projet Google dédié au bot. Obligatoire si LLM_ENABLED=1 : sans elle, le bot refuse de démarrer.
SUPPORT_LLM_API_KEY=
# Appels simultanés au rédacteur, et brouillons en cours au-delà desquels il n'y en a plus.
LLM_CONCURRENCY=2
LLM_MAX_QUEUE=10
